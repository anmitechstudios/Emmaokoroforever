# Public address of the memorial (used for share links and social previews).
# On Vercel this defaults to the project's production domain.
SITE_URL=https://example.com

# A long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The first administrator. Created automatically on first run, when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — which memorial this deployment shows (defaults to the first one).
# MEMORIAL_SLUG=emmanuel-okoro

# Supabase — required in production (run supabase/schema.sql first).
# When unset locally, the site uses a file store in .data/ instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
